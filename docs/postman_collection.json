{
  "info": {
    "name": "ASLPS API Collection",
    "description": "Complete API collection for Adaptive Storage Location Prediction System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', jsonData.access);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.refresh);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/token/",
              "host": ["{{base_url}}"],
              "path": ["token", ""]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/token/refresh/",
              "host": ["{{base_url}}"],
              "path": ["token", "refresh", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/health/",
          "host": ["{{base_url}}"],
          "path": ["health", ""]
        }
      }
    },
    {
      "name": "Components",
      "item": [
        {
          "name": "List Components",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/components/",
              "host": ["{{base_url}}"],
              "path": ["components", ""]
            }
          }
        },
        {
          "name": "Get Component",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/components/COMP-001/",
              "host": ["{{base_url}}"],
              "path": ["components", "COMP-001", ""]
            }
          }
        },
        {
          "name": "Create Component",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"component_id\": \"COMP-999\",\n  \"name\": \"Test Component\",\n  \"category\": \"Test\",\n  \"weight_kg\": 10.0,\n  \"length_m\": 1.0,\n  \"width_m\": 0.5,\n  \"height_m\": 0.2,\n  \"is_hazardous\": false,\n  \"requires_climate_control\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/components/",
              "host": ["{{base_url}}"],
              "path": ["components", ""]
            }
          }
        },
        {
          "name": "Update Component",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"component_id\": \"COMP-001\",\n  \"name\": \"Updated Component\",\n  \"category\": \"Mechanical\",\n  \"weight_kg\": 0.5,\n  \"length_m\": 0.05,\n  \"width_m\": 0.05,\n  \"height_m\": 0.02,\n  \"is_hazardous\": false,\n  \"requires_climate_control\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/components/COMP-001/",
              "host": ["{{base_url}}"],
              "path": ["components", "COMP-001", ""]
            }
          }
        },
        {
          "name": "Delete Component",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/components/COMP-999/",
              "host": ["{{base_url}}"],
              "path": ["components", "COMP-999", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Shelves",
      "item": [
        {
          "name": "List Shelves",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/shelves/",
              "host": ["{{base_url}}"],
              "path": ["shelves", ""]
            }
          }
        },
        {
          "name": "Get Shelf",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/shelves/SHELF-A-01-01/",
              "host": ["{{base_url}}"],
              "path": ["shelves", "SHELF-A-01-01", ""]
            }
          }
        },
        {
          "name": "Create Shelf",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shelf_id\": \"SHELF-TEST-001\",\n  \"location\": {\n    \"x\": 10.0,\n    \"y\": 20.0,\n    \"z\": 5.0,\n    \"zone\": \"A\"\n  },\n  \"max_weight_kg\": 100.0,\n  \"max_volume_m3\": 10.0,\n  \"is_hazardous_zone\": false,\n  \"has_climate_control\": false,\n  \"adjacent_shelves\": [],\n  \"distance_to_entrance\": 15.0\n}"
            },
            "url": {
              "raw": "{{base_url}}/shelves/",
              "host": ["{{base_url}}"],
              "path": ["shelves", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Movement Logs",
      "item": [
        {
          "name": "List Movement Logs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/movements/?hours=24",
              "host": ["{{base_url}}"],
              "path": ["movements", ""],
              "query": [
                {
                  "key": "hours",
                  "value": "24"
                }
              ]
            }
          }
        },
        {
          "name": "Create Movement Log",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"component_id\": \"COMP-001\",\n  \"shelf_id\": \"SHELF-A-01-01\",\n  \"movement_type\": \"STORAGE\",\n  \"duration_seconds\": 180.0,\n  \"operator_id\": \"OP-01\",\n  \"congestion_at_time\": 0.3\n}"
            },
            "url": {
              "raw": "{{base_url}}/movements/",
              "host": ["{{base_url}}"],
              "path": ["movements", ""]
            }
          }
        }
      ]
    },
    {
      "name": "ML Prediction",
      "item": [
        {
          "name": "Predict Location",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"component_id\": \"COMP-001\",\n  \"consider_congestion\": true,\n  \"preferred_zones\": [\"A\", \"B\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/ml/predict-location/",
              "host": ["{{base_url}}"],
              "path": ["ml", "predict-location", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Model Performance",
      "item": [
        {
          "name": "Get Performance Metrics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/model-performance/?version=latest&hours=168",
              "host": ["{{base_url}}"],
              "path": ["model-performance", ""],
              "query": [
                {
                  "key": "version",
                  "value": "latest"
                },
                {
                  "key": "hours",
                  "value": "168"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}

